<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">


    <jp.ne.sakura.miyadai.roboconRemote.HorizontalStickSurfaceview
        android:id="@+id/horizontalStickSurfaceview"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="4:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/JoyStick_after_guideline" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/JoyStick_after_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/JoyStick_before_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.2" />

    <com.longdo.mjpegviewer.MjpegView
        android:id="@+id/mjpegview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/JoyStick_after_guideline"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/JoyStick_before_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/bldc_rpm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="0RPM"
        app:layout_constraintEnd_toStartOf="@+id/roller_speed"
        app:layout_constraintTop_toBottomOf="@+id/text_roller" />

    <TextView
        android:id="@+id/text_roller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="28dp"
        android:text="ローラ"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_roller2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ブラシ"
        app:layout_constraintEnd_toStartOf="@+id/switch_brush"
        app:layout_constraintStart_toStartOf="@+id/JoyStick_after_guideline"
        app:layout_constraintTop_toTopOf="parent" />

    <SeekBar
        android:id="@+id/roller_speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:thumb="@drawable/bar_thumb"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toStartOf="@+id/JoyStick_before_guideline"
        app:layout_constraintTop_toBottomOf="@+id/text_roller" />

    <TextView
        android:id="@+id/RPM_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="0RPM"
        app:layout_constraintEnd_toStartOf="@+id/bldc_rpm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_roller" />

    <Switch
        android:id="@+id/switch_roller"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/swtich_track"
        android:showText="false"
        android:thumb="@drawable/switch_thumb"
        android:track="@drawable/swtich_track"
        app:layout_constraintEnd_toStartOf="@+id/JoyStick_before_guideline"
        app:layout_constraintStart_toEndOf="@+id/text_roller"
        app:layout_constraintTop_toTopOf="parent" />

    <Switch
        android:id="@+id/switch_brush"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/swtich_track"
        android:showText="false"
        android:thumb="@drawable/switch_thumb"
        android:track="@drawable/swtich_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>